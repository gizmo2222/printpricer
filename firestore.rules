rules_version = '2';

// Print Pricer — Firestore security rules.
// Paste these into Firebase console → Firestore → Rules tab, then publish.
//
// Model:
//   users/{uid}                       — per-user record (email, currentGroupId)
//   groups/{gid}                      — group doc (name, joinCode, members[], ownerUid)
//   groups/{gid}/spools/{id}          — shared spool inventory
//   groups/{gid}/archive/{id}         — shared estimate archive
//   groups/{gid}/settings/main        — shared defaults
//
// Anonymous users have no group access. Email-authed users can read any group
// doc (so they can look up by joinCode), but can only modify groups they
// belong to (or are joining via members arrayUnion).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- users ----------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- groups ----------
    function isMember(gid) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }

    function isMemberOnNew(gid) {
      // Used during create to avoid get() on non-existent doc
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid in request.resource.data.members;
    }

    match /groups/{gid} {
      // Any authenticated, non-anonymous user can read group docs (needed for
      // joinCode lookup). Doc is small and contains no sensitive data.
      allow read: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider != 'anonymous';

      // Create: must be authed and listed in members at creation time.
      allow create: if isMemberOnNew(gid)
                    && request.resource.data.ownerUid == request.auth.uid;

      // Update: existing members may update freely. Non-members may update
      // ONLY to add themselves (joining). They cannot rename / change owner /
      // remove other members.
      allow update: if (request.auth != null
                       && request.auth.token.firebase.sign_in_provider != 'anonymous')
                    && (
                      // existing member: full update rights
                      request.auth.uid in resource.data.members
                      ||
                      // non-member joining: only members[] changes, only by adding self
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members.hasAll(resource.data.members)
                        && request.resource.data.members.size() == resource.data.members.size() + 1
                        && request.auth.uid in request.resource.data.members
                      )
                    );

      // Delete: only the owner.
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // ---------- group sub-collections ----------
      match /spools/{id} {
        allow read, write: if isMember(gid);
      }
      match /archive/{id} {
        allow read, write: if isMember(gid);
      }
      match /settings/{id} {
        allow read, write: if isMember(gid);
      }
    }
  }
}
